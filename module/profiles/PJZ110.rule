# PJZ110 机型规则
# 数值段为该机型的充电参数表，节点结构与取值一一对应。

[chg_boost]
  title    UFCS 150W/13.7A 与 PPS 6.5A
  default  on
  node     &oplus_cpa
  set      oplus,protocol_list = <0x04 0x96 0x03 0x64 0x02 0x55 0x01 0x12 0x05 0x12>
  verify   oplus,protocol_list == <0x04 0x96 0x03 0x64 0x02 0x55 0x01 0x12 0x05 0x12>
  set      oplus,default_protocol_list = <0x04 0x01 0x02 0x03>
  node     &oplus_ufcs_charge
  set      silicon_p_770 : oplus,adsp_ufcs_project = !
  set      silicon_p_770 : oplus,ufcs_need_reset_adapter = !
  set      silicon_p_770 : oplus,target_vbus_mv = <0x2af8>
  set      silicon_p_770 : oplus,curr_max_ma = <0x3908>
  set      silicon_p_770 : oplus,subboard_ntc_abnormal_current = <0x1c84>
  set      silicon_p_770 : oplus,ufcs_warm_allow_vol = <0xfa0>
  set      silicon_p_770 : oplus,ufcs_warm_allow_soc = <0x37>
  set      silicon_p_770 : oplus,ufcs_strategy_normal_current = <0x3908>
  set      silicon_p_770 : oplus,ufcs_over_high_or_low_current = <0x3908>
  set      silicon_p_770 : oplus,ufcs_timeout_third = <0x3859>
  set      silicon_p_770 : oplus,ufcs_timeout_oplus = <0x3859>
  set      silicon_p_770 : oplus,ufcs_ibat_over_third = <0x3908>
  set      silicon_p_770 : oplus,ufcs_ibat_over_oplus = <0x3908>
  set      silicon_p_770 : oplus,ufcs_ibus_over_oplus = <0x3778>
  set      silicon_p_770 : oplus,ufcs_full_cool_sw_vbat = <0x11f8>
  set      silicon_p_770 : oplus,ufcs_full_normal_sw_vbat = <0x11f8>
  set      silicon_p_770 : oplus,ufcs_full_normal_hw_vbat = <0x1202>
  set      silicon_p_770 : oplus,ufcs_full_ffc_vbat = <0x11bc>
  set      silicon_p_770 : oplus,ufcs_full_warm_vbat = <0x1022>
