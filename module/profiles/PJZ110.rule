  set      silicon_p_770 : oplus,ufcs_full_normal_sw_vbat_third = <0x11f8>
  set      silicon_p_770 : oplus,ufcs_full_normal_hw_vbat_third = <0x1202>
  set      silicon_p_770 : oplus,ufcs_current_change_timeout = <0x64>
  set      silicon_p_770 : oplus,ufcs_strategy_high_current = <0x1388 0xfa0 0xbb8 0x3908 0x1388 0xfa0>
