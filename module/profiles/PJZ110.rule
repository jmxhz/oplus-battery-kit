[batt_therm]
  title    温度墙抬高到 48/53 摄氏度
  default  off
  suggest  fake_temp
  warn     抬高温度墙会显著增加发热与电池风险，需配合温度伪装才会走到 53 度档
  node     &oplus_ufcs_charge
  set      silicon_p_770 : oplus,ufcs_strategy_batt_high_temp = <530 530 530 530 530 530>
  set      silicon_p_770 : oplus,ufcs_charge_strategy_temp = <0 50 120 160 400 480 530>
  set      silicon_p_770/ufcs_charge_third_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  set      silicon_p_770/ufcs_charge_oplus_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  node     &oplus_pps_charge
  set      silicon_p_770 : oplus,pps_strategy_batt_high_temp = <530 530 530 530 530 530>
  set      silicon_p_770 : oplus,pps_charge_strategy_temp = <0 50 120 160 400 480 530>
  set      silicon_p_770/pps_charge_third_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  set      silicon_p_770/pps_charge_oplus_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  node     &oplus_adsp_voocphy
  set      oplus_spec,vooc_low_temp = <0>
  set      oplus_spec,vooc_little_cold_temp = <0>
  set      oplus_spec,vooc_cool_temp = <0>
  set      oplus_spec,vooc_little_cool_temp = <100>
  set      oplus_spec,vooc_little_cool_high_temp = <150>
  set      oplus_spec,vooc_normal_low_temp = <420>
  set      oplus_spec,vooc_normal_high_temp = <480>
  set      oplus_spec,vooc_high_temp = <530>
  set      oplus_spec,vooc_over_high_temp = <550>
  verify   oplus_spec,vooc_low_temp == <0>

[soc_smooth]
  title    显示真实电量
  default  on
  node     &oplus_chg_comm
  set      silicon_p_770 : oplus,reserve_chg_soc = <0>
  set      silicon_p_770 : oplus,reserve_dis_soc = <0>
  set      silicon_p_770/smooth_strategy : oplus_spec,reserve_table_centipercent = <0x00 0x64 0x00 0x00 0x00 0x64>

[ddrc]
  title    解除深放降容
  desc     深放计数不再累积，放电截止电压固定在地板值，不再按截止电压修正 FCC
  default  on
  warn     电池被允许放到更低电压，长期如此会加速容量衰减
  node     &oplus_mms_gauge
  prefer   silicon_p_770
  read     $uv = deep_spec,uv_thr
  set      deep_spec,count_thr  = <0>
  set      deep_spec,vbat_soc   = <0>
  set      deep_spec,count_step = <0 0 0>
  set      deep_spec,term_coeff = <0 0 0>
  each     ddrc_strategy/strategy_ratio_range_* : strategy_temp_* = <0 $uv $uv 0>
  verify   deep_spec,count_step == <0 0 0>
  verify   deep_spec,term_coeff == <0 0 0>

[dsi_timing]
  title    移除 60/90 Hz 刷新率档位
  default  off
  warn     改动显示时序，异常时请先关闭此项
  node     &dsi_panel_AA569_P_3_A0019_dsc_cmd
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_90
  node     &dsi_panel_AA569_P_3_A0019_dsc_cmd_evt
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_90
  node     &dsi_panel_AA569_P_3_A0019_dsc_cmd_evb
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_90
  node     &dsi_panel_BF262_P_3_A0021_dsc_cmd
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_90
  node     &dsi_panel_AA545_P_3_A0005_dsc_cmd
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_90
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_60
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_60
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_60
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_60
  rm?      qcom,mdss-dsi-display-timings/timing@wqhd_sdc_60
