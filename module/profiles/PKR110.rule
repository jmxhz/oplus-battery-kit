  set      pps_charge_oplus_strategy/strategy_soc_range_high : strategy_temp_normal_high = <0x2af8 0x11d0 0x7d0 0x00 0x00 0x2af8 0x11da 0x76c 0x01 0x00>
  set      pps_charge_oplus_strategy/strategy_soc_range_high : strategy_temp_warm = <0x2af8 0x1022 0x3e8 0x01 0x00>

[batt_therm]
  title    温度墙抬高到 48/53 摄氏度
  default  off
  suggest  fake_temp
  warn     抬高温度墙会显著增加发热与电池风险，需配合温度伪装才会走到 53 度档
  node     &oplus_ufcs_charge
  set      oplus,ufcs_strategy_batt_high_temp = <530 530 530 530 530 530>
  verify   oplus,ufcs_strategy_batt_high_temp == <530 530 530 530 530 530>
  set      oplus,ufcs_charge_strategy_temp = <0 50 120 160 400 480 530>
  set      oplus_spec,ufcs_low_temp = <0>
  set      ufcs_charge_third_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  set      ufcs_charge_oplus_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  node     &oplus_pps_charge
  set      oplus,pps_strategy_batt_high_temp = <530 530 530 530 530 530>
  set      oplus,pps_charge_strategy_temp = <0 50 120 160 400 480 530>
  set      oplus,pps_low_temp = <0>
  set      pps_charge_third_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  set      pps_charge_oplus_strategy : oplus,temp_range = <0 50 120 160 210 400 480 530>
  node     &oplus_adsp_voocphy
  set      oplus_spec,vooc_low_temp = <0>
  set      oplus_spec,vooc_little_cold_temp = <0>
  set      oplus_spec,vooc_cool_temp = <0>
  set      oplus_spec,vooc_little_cool_temp = <100>
  set      oplus_spec,vooc_little_cool_high_temp = <150>
  set      oplus_spec,vooc_normal_low_temp = <420>
  set      oplus_spec,vooc_normal_high_temp = <480>
  set      oplus_spec,vooc_high_temp = <530>
  set      oplus_spec,vooc_over_high_temp = <550>

[soc_smooth]
  title    显示真实电量
  default  on
  node     &oplus_chg_comm
  set      oplus,reserve_chg_soc = <0>
  set      oplus,reserve_dis_soc = <0>
  set      smooth_strategy : oplus_spec,reserve_table_centipercent = <0x00 0x64 0x00 0x00 0x00 0x64>
  verify   oplus,reserve_chg_soc == <0>
