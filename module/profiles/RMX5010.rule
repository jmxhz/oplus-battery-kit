[batt_therm]
  title    温度墙抬高到 48/53 摄氏度
  default  off
  suggest  fake_temp
  warn     抬高温度墙会显著增加发热与电池风险，需配合温度伪装才会走到 53 度档
  node     &oplus_ufcs_charge
  set      oplus,ufcs_strategy_batt_high_temp = <520 540 560 500 540 560>
  verify   oplus,ufcs_strategy_batt_high_temp == <520 540 560 500 540 560>
  set      oplus,ufcs_charge_strategy_temp = <0 50 120 160 400 540 560>
  set      ufcs_charge_third_strategy : oplus,temp_range = <0 50 120 160 210 400 540 560>
  set      ufcs_charge_oplus_strategy : oplus,temp_range = <0 50 120 160 210 400 540 560>
  node     &oplus_pps_charge
  set      oplus,pps_strategy_batt_high_temp = <520 540 560 500 540 560>
  set      oplus,pps_charge_strategy_temp = <0 50 120 160 400 540 560>
  set      pps_charge_third_strategy : oplus,temp_range = <0 50 120 160 210 400 540 560>
  set      pps_charge_oplus_strategy : oplus,temp_range = <0 50 120 160 210 400 540 560>
  node     &oplus_adsp_voocphy
  set      oplus_spec,vooc_low_temp = <0>
  set      oplus_spec,vooc_little_cold_temp = <0>
  set      oplus_spec,vooc_cool_temp = <0>
  set      oplus_spec,vooc_little_cool_temp = <100>
  set      oplus_spec,vooc_little_cool_high_temp = <150>
  set      oplus_spec,vooc_normal_low_temp = <420>
  set      oplus_spec,vooc_normal_high_temp = <480>
  set      oplus_spec,vooc_high_temp = <510>
  set      oplus_spec,vooc_over_high_temp = <530>

[soc_smooth]
  title    显示真实电量
  default  on
  node     &oplus_chg_comm
  set      oplus,reserve_chg_soc = <0x00>
  set      oplus,hidden_soc_percent = <0x00>
  verify   oplus,reserve_chg_soc == <0x00>

[pdqc]
  title    解锁 PDQC 充电功率 27W
  default  off
  node     &oplus_chg_wired
  set      oplus_spec,pd-iclmax-ma = <0xbb8>
  set      oplus_spec,qc-iclmax-ma = <0xbb8>
  set      oplus_spec,non-standard-ibatmax-ma = <0x384>
  set      oplus_spec,input-power-mw = <0x9c4 0x9c4 0x1d4c 0x2710 0x3a98 0x3840 0x3840>
  set      oplus_spec,fccmax-ma-lv = <0x00 0xfc 0x44c 0x44c 0x44c 0x44c 0x44c 0x44c 0x00 0x00 0xfc 0x384 0x384 0x384 0x384 0x384 0x384 0x00 0x00 0xfc 0x320 0x320 0x320 0x320 0x320 0x320 0x00 0x00 0xfc 0x44c 0x44c 0x44c 0x44c 0x44c 0x44c 0x00 0x00 0xfc 0x4ee 0x672 0x672 0x672 0x672 0x607 0x00 0x00 0xfc 0x4ee 0x7e4 0x898 0x898 0x898 0x607 0x00 0x00 0xfc 0x4ee 0x7e4 0x898 0x898 0x898 0x607 0x00>
  set      oplus_spec,fccmax-ma-hv = <0x00 0xfc 0x1f9 0x2f5 0x44c 0x44c 0x44c 0x44c 0x00 0x00 0xfc 0x384 0x384 0x384 0x384 0x384 0x384 0x00 0x00 0xfc 0x1f9 0x2f5 0x320 0x320 0x320 0x320 0x00 0x00 0xfc 0x1f9 0x2f5 0x44c 0x44c 0x44c 0x44c 0x00 0x00 0xfc 0x1f9 0x2f5 0x4ee 0x672 0x672 0x607 0x00 0x00 0xfc 0x1f9 0x2f5 0x4ee 0x898 0x898 0x607 0x00 0x00 0xfc 0x1f9 0x2f5 0x4ee 0x898 0x898 0x607 0x00>
  set      oplus_spec,cool_down_pdqc_vol_mv = <0x2328 0x2328 0x2328>
  set      oplus_spec,cool_down_pdqc_curr_ma = <0x640 0x9c4 0xbb8>
  set      oplus_spec,cool_down_vooc_curr_ma = <0x4b0 0x5dc 0x7d0 0x9c4 0xbb8 0xbb8>
  set      oplus_spec,cool_down_normal_curr_ma = <0x4b0 0x5dc 0x7d0>
  verify   oplus_spec,pd-iclmax-ma == <0xbb8>

[soc_battery]
  title    关机电压下调到 2.8V
  default  off
  warn     进一步压低关机电压，低电量下高负载更易保护性关机
  node     &oplus_chg_comm
  set      oplus_spec,fv-mv = <0x119e 0x119e 0x119e 0x119e 0x119e 0x119e 0x119e 0x119e 0x1185>
  set      oplus_spec,sw-fv-mv = <0x116c 0x116c 0x116c 0x116c 0x116c 0x116c 0x116c 0x116c 0x1153>
  set      oplus_spec,sw-over-fv-mv = <0x11a8 0x11a8 0x11a8 0x11a8 0x11a8 0x11a8 0x11a8 0x11a8 0x118f>
  set      oplus_spec,vbat_uv_thr_mv = <0xaf0>
  set      oplus_spec,vbat_charging_uv_thr_mv = <0xa8c>
  set      oplus,chg_shutdown_max_mv = <0xaf0>
  verify   oplus_spec,fv-mv == <0x119e 0x119e 0x119e 0x119e 0x119e 0x119e 0x119e 0x119e 0x1185>

[ddrc]
  title    解除深放降容
  desc     深放计数不再累积，放电截止电压固定在地板值，不再按截止电压修正 FCC
  default  on
  warn     电池被允许放到更低电压，长期如此会加速容量衰减
  node     &oplus_mms_gauge
  prefer   silicon_p_x24
  read     $uv = deep_spec,uv_thr
  set      deep_spec,count_thr  = <0>
  set      deep_spec,vbat_soc   = <0>
  set      deep_spec,count_step = <0 0 0>
  set      deep_spec,term_coeff = <0 0 0>
  each     ddrc_strategy/strategy_ratio_range_* : strategy_temp_* = <0 $uv $uv 0>
  verify   deep_spec,count_step == <0 0 0>
  verify   deep_spec,term_coeff == <0 0 0>
